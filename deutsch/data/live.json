    "items": [
      {
        "id": 1,
        "title_de": "Personalpronomen",
        "title_en": "Personal pronouns",
        "lead": "Use ich, du, er, sie, es, wir, ihr, sie, Sie instead of repeating a name.",
        "tables": [
          {
            "headers": [
              "Pronoun",
              "Meaning",
              "When"
            ],
            "rows": [
              [
                "ich",
                "I",
                "talking about yourself"
              ],
              [
                "du",
                "you",
                "one person you know"
              ],
              [
                "er",
                "he / it",
                "a man, or a der word"
              ],
              [
                "sie",
                "she / it",
                "a woman, or a die word"
              ],
              [
                "es",
                "it",
                "a das word"
              ],
              [
                "wir",
                "we",
                "you and others"
              ],
              [
                "ihr",
                "you (plural)",
                "people you know"
              ],
              [
                "sie",
                "they",
                "more than one person"
              ],
              [
                "Sie",
                "you (formal)",
                "polite form"
              ]
            ]
          }
        ],
        "formula": "pronoun + verb + the rest",
        "examples": [
          {
            "de": "Ich wohne in Hamburg.",
            "en": "I live in Hamburg."
          },
          {
            "de": "Du lernst Deutsch.",
            "en": "You are learning German."
          },
          {
            "de": "Mynul wohnt in Hamburg. Er studiert dort.",
            "en": "Mynul lives in Hamburg. He studies there."
          },
          {
            "de": "Lena kommt aus Deutschland. Sie spricht Deutsch.",
            "en": "Lena comes from Germany. She speaks German."
          },
          {
            "de": "Das Kind spielt. Es ist glücklich.",
            "en": "The child is playing. It is happy."
          },
          {
            "de": "Wir lernen zusammen.",
            "en": "We learn together."
          },
          {
            "de": "Ihr wohnt in Hamburg.",
            "en": "You (plural) live in Hamburg."
          },
          {
            "de": "Ali und Sara arbeiten heute. Sie sind müde.",
            "en": "Ali and Sara are working today. They are tired."
          },
          {
            "de": "Wo wohnen Sie?",
            "en": "Where do you (formal) live?"
          }
        ],
        "note": "sie = she / they (small s). Sie = formal you (capital S). At the start of a sentence both can look the same. Check the verb.",
        "drills": [
          {
            "prompt": "Mynul kommt aus Bangladesch. ___ wohnt in Hamburg.",
            "answer": "Er",
            "en": "He lives in Hamburg."
          },
          {
            "prompt": "Anna lernt Deutsch. ___ spricht schon gut.",
            "answer": "Sie",
            "en": "She already speaks well."
          },
          {
            "prompt": "Ali und ich sind Freunde. ___ lernen zusammen.",
            "answer": "Wir",
            "en": "We learn together."
          },
          {
            "prompt": "Sara und Maria arbeiten heute. ___ sind müde.",
            "answer": "Sie",
            "en": "They are tired."
          },
          {
            "prompt": "Herr Müller, wohnen ___ in Berlin?",
            "answer": "Sie",
            "en": "Do you (formal) live in Berlin?"
          },
          {
            "prompt": "Das Baby schläft. ___ ist müde.",
            "answer": "Es",
            "en": "It is tired."
          }
        ]
      }
    ]
